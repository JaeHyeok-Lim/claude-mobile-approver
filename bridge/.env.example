# bridge/ configuration. Copy to .env and fill in real values. .env is gitignored.

# Shared bearer token. EVERY request (hooks + app) must send `Authorization: Bearer <BRIDGE_TOKEN>`.
# Generate a strong one, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# REQUIRED. If unset/empty the bridge refuses to start (a tokenless gate is not a gate).
BRIDGE_TOKEN=replace-me-with-a-long-random-secret

# Port the HTTP/SSE service listens on. The PreToolUse hook defaults to 127.0.0.1:4318.
PORT=4318

# Bind address. Keep loopback by default — the bridge must NOT be an open public endpoint;
# expose it only behind an authenticated tunnel / private network.
HOST=127.0.0.1

# Approval TTL in milliseconds. A pending request not resolved within this window is treated
# as DENY (default-deny). Keep this >= the hook's APPROVE_TOTAL_MS budget (default 120000).
APPROVAL_TTL_MS=120000

# How long resolved/expired approvals linger in the store before cleanup (ms). Display only.
APPROVAL_RETAIN_MS=600000

# Max events kept in the in-memory feed ring buffer.
EVENT_BUFFER_MAX=200

# Expo Push API endpoint. Leave as default unless self-hosting Expo's push service.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ---- Resource caps / rate limits (DoS + brute-force hardening) ----
# Per-IP sliding window (ms) and max requests per window across ALL /v1 routes.
RATE_WINDOW_MS=60000
RATE_MAX=120
# Tighter per-IP budget for sensitive ops: POST /v1/approvals/:id/resolve and auth failures
# (blunts token brute-force). Over budget -> 429 { error: "rate_limited" }.
RATE_SENSITIVE_MAX=20
# Max concurrent SSE subscribers on GET /v1/live (overall, and per source IP).
LIVE_MAX_CLIENTS=50
LIVE_MAX_PER_IP=5
# Max distinct PENDING approvals; creates beyond this are rejected with 429.
APPROVAL_MAX_PENDING=200
# Max registered push devices; the oldest is evicted when full.
DEVICE_MAX=50
