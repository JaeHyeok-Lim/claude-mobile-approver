# Expo public env (EXPO_PUBLIC_* is inlined into the JS bundle — never put a real
# secret here that must stay private from the device; the bridge token below DOES
# ship in the bundle, which is acceptable only behind the authenticated tunnel /
# private network the bridge lives on. Copy to .env (gitignored) and fill in.)

# Base URL of the bridge service, including the /v1 prefix.
# Local dev: http://<your-LAN-ip>:4318/v1  (localhost won't resolve from a phone)
EXPO_PUBLIC_BRIDGE_BASE_URL=http://localhost:4318/v1

# Shared bearer token. Must match the bridge's BRIDGE_TOKEN.
EXPO_PUBLIC_BRIDGE_TOKEN=replace-with-shared-bridge-token

# EAS project id, used to mint the Expo push token. Find it after `eas init`.
EXPO_PUBLIC_EAS_PROJECT_ID=
