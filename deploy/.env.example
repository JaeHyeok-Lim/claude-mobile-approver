# deploy/ tunnel configuration. Copy to deploy/.env (gitignored) and fill in.
# These select WHICH tunnel scripts/tunnel.mjs (and scripts/up.mjs) bring up.
# No secrets belong here — provider credentials live in the provider's own config
# (cloudflared cert/credentials json, `ngrok config add-authtoken`).

# Which provider: cloudflare | ngrok
TUNNEL_PROVIDER=cloudflare

# cloudflare modes:
#   quick  -> ephemeral *.trycloudflare.com (UNAUTHENTICATED edge; bridge token is the
#             only gate). Fine for short local testing.
#   named  -> stable hostname from a named tunnel; put it behind Cloudflare Access so
#             the edge is authenticated too. Use this for anything persistent.
# (ignored when TUNNEL_PROVIDER=ngrok)
TUNNEL_MODE=quick

# --- cloudflare named mode only ---
# Name of the named tunnel created via `cloudflared tunnel create <name>`.
# Referenced by deploy/cloudflared/config.yml.
CF_TUNNEL_NAME=agent-mobile-bridge

# --- ngrok only ---
# Name of the endpoint block in deploy/ngrok.yml to start.
NGROK_ENDPOINT=bridge
